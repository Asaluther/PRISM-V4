# Python
__pycache__/
*.pyc
*.pyo
.venv/

# 模型 checkpoint（过大，不进仓库）
*.pt
*.pth

# 数据缓存（公开 HF 数据集，运行时自动下载）
cache/

# 训练日志（结果 JSON 已保留，日志太长）
*.log
results/*.out

# 已归档的双向时代数据（见 results/_invalid_bidirectional/README.md 说明）
results/_invalid_bidirectional/

# 临时文件
tmp/
*.tmp
.DS_Store
.zcode/
*.tar.gz
*.zip

# 外部预训练权重（gpt2-medium 手动下载，不入库）
gpt2m/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
